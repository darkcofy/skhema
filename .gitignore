# Rendered output (reproducible from source)
rendered/

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Client folders — only public demo (meshco) is committed.
# All other client workspaces (real EY / Herdwatch content) live locally.
clients/*
!clients/meshco/

# Rendered + generated artefacts are always local (reproducible from source)
clients/*/rendered/
clients/*/*.html
clients/*/*.pdf
clients/*/*.pptx
clients/*/deck_pages/
clients/*/diagrams/c4/exported/

# Structurizr Lite runtime state (logs, search index, history)
clients/*/.structurizr/
clients/*/workspace.json

# Working docs — plans, specs, design notes (local-only, not part of deliverable)
docs/

# Superpowers plugin local state
.superpowers/

# Worktrees
.worktrees/

# Editor
.vscode/
.idea/
*.swp
