#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
PYTHON="${SKHEMA_PYTHON:-python3}"

usage() {
  cat <<'EOF'
skhema — architecture diagrams as code

Usage: skhema <command> [options]

Commands:
  init      Scaffold a new client directory structure
  render    Render PlantUML diagrams via Kroki API
  gallery   Generate self-contained HTML gallery
  docs      Generate living docs architecture handbook
  deck      Export PDF or PowerPoint deck
  validate  Lint diagrams for convention violations
  adr       Analyze and visualize architecture decision records
  demo      Regenerate all outputs for a client

Run 'skhema <command> --help' for command-specific options.
EOF
  exit 0
}

[[ $# -eq 0 ]] && usage

cmd="$1"; shift

case "$cmd" in
  init)
    if [[ $# -eq 0 ]]; then
      echo "Usage: skhema init <client-name>" >&2
      exit 1
    fi
    name="$1"
    dir="$ROOT/clients/$name"
    if [[ -d "$dir" ]]; then
      echo "Client '$name' already exists at $dir" >&2
      exit 1
    fi
    # Convert kebab-case to Title Case for display name
    display_name=$(echo "$name" | sed 's/-/ /g; s/_/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)}1')
    mkdir -p "$dir"/{diagrams/{c4,sequence,erd,deployment},models,docs}
    cat > "$dir/client.yaml" <<YAML
name: "$display_name"
subtitle: "Architecture Documentation"
accent_color: "#D97706"
sections:
  - c4
  - sequence
  - erd
  - deployment
YAML
    cat > "$dir/docs/overview.md" <<MD
# $display_name

*Add a brief description of the client and the scope of this architecture documentation.*
MD
    echo "Client '$name' created at $dir"
    echo ""
    echo "Next steps:"
    echo "  1. Add diagrams to clients/$name/diagrams/c4/"
    echo "  2. Render:  skhema render --client $name --all --animate"
    echo "  3. Gallery: skhema gallery --client $name"
    echo "  4. Docs:    skhema docs --client $name"
    echo "  5. Or all:  skhema demo $name"
    ;;
  render)   PYTHONPATH="$ROOT/skhema" exec "$PYTHON" -m scripts.render "$@" ;;
  gallery)  PYTHONPATH="$ROOT/skhema" exec "$PYTHON" -m scripts.gallery "$@" ;;
  docs)     PYTHONPATH="$ROOT/skhema" exec "$PYTHON" -m scripts.docs "$@" ;;
  deck)     PYTHONPATH="$ROOT/skhema" exec "$PYTHON" -m scripts.deck "$@" ;;
  validate) PYTHONPATH="$ROOT/skhema" exec "$PYTHON" -m scripts.validate "$@" ;;
  adr)      PYTHONPATH="$ROOT/skhema" exec "$PYTHON" -m scripts.adr "$@" ;;
  demo)
    client="${1:-demo}"
    echo "=== Rendering diagrams for '$client' ==="
    PYTHONPATH="$ROOT/skhema" "$PYTHON" -m scripts.render --client "$client" --all --animate
    echo ""
    echo "=== Generating gallery ==="
    PYTHONPATH="$ROOT/skhema" "$PYTHON" -m scripts.gallery --client "$client" --history 0
    echo ""
    echo "=== Generating living docs ==="
    PYTHONPATH="$ROOT/skhema" "$PYTHON" -m scripts.docs --client "$client"
    echo ""
    echo "=== Generating PDF deck ==="
    PYTHONPATH="$ROOT/skhema" "$PYTHON" -m scripts.deck --client "$client"
    echo ""
    echo "Done. Outputs in clients/$client/"
    ;;
  help|-h|--help) usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Run 'skhema help' for usage." >&2
    exit 1
    ;;
esac
