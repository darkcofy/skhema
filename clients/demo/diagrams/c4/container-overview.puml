@startuml
!include ../../../../lib/theme.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
$ApplySkinparams()

!include ../../models/novapay-personas.puml
!include ../../models/novapay-core.puml
!include ../../models/legacy-erp.puml
!include ../../../../models/storage.puml
!include ../../../../models/integration.puml

title NovaPay — Container Overview

$Consumer()
$Merchant()

$MobileApp()
$MerchantPortal()
$PaymentEngine()
$FraudDetector()
$LedgerSvc()
$NotificationSvc()
$WebhookEngine()

$MessageBroker()
$OperationalDb()
$CacheLayer()

$CardNetwork()
$LegacyCore()

Rel(consumer, mobile_app, "~Uses", "HTTPS")
Rel(merchant, merchant_portal, "~Uses", "HTTPS")
Rel(mobile_app, payment_engine, "~Initiates payment", "REST")
Rel(merchant_portal, payment_engine, "~Manages txns", "REST")
Rel(payment_engine, fraud_detector, "~Checks risk", "gRPC")
Rel(payment_engine, ledger_svc, "~Records", "gRPC")
Rel(payment_engine, card_network, "~Authorizes", "ISO 8583")
Rel(payment_engine, message_broker, "~Publishes events", "Kafka")
Rel(message_broker, notification_svc, "~Triggers", "Kafka")
Rel(message_broker, webhook_engine, "~Triggers", "Kafka")
Rel(ledger_svc, operational_db, "~Persists", "PostgreSQL")
Rel(fraud_detector, cache_layer, "Reads features", "Redis")
Rel(payment_engine, legacy_core, "~Settles", "MQ")

LAYOUT_WITH_LEGEND()
@enduml
