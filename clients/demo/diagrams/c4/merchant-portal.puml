@startuml
!include ../../../../lib/theme.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
$ApplySkinparams()

!include ../../../../models/security.puml

title NovaPay — Merchant Portal Components

Container_Boundary(mp, "Merchant Portal") {
  Component(portal_spa, "Portal SPA", "React", "Single-page app\nmerchant dashboard")
  Component(portal_bff, "Portal BFF", "Node.js", "Backend-for-frontend\naggregation layer")
  Component(txn_viewer, "Transaction Viewer", "React", "Search, filter, export\ntransaction history")
  Component(payout_mgr, "Payout Manager", "React", "Payout schedules\nand bank account setup")
  Component(dispute_mgr, "Dispute Manager", "React", "Chargeback handling\nand evidence upload")
}

$IdentityProvider()
$AuthGateway()

Component_Ext(payment_api, "Payment Engine", "REST", "Transaction data")
Component_Ext(ledger_api, "Ledger Service", "gRPC", "Balance & payouts")

Rel(portal_spa, portal_bff, "~Calls", "GraphQL")
Rel(portal_bff, payment_api, "~Reads txns", "REST")
Rel(portal_bff, ledger_api, "~Reads balances", "gRPC")
Rel(portal_spa, identity_provider, "~SSO login", "OIDC")
Rel(portal_bff, auth_gateway, "~Validates token", "JWT")
Rel(txn_viewer, portal_bff, "~Queries", "GraphQL")
Rel(payout_mgr, portal_bff, "~Manages", "GraphQL")
Rel(dispute_mgr, portal_bff, "~Submits", "GraphQL")

LAYOUT_WITH_LEGEND()
@enduml
