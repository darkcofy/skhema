@startuml
!include ../../../../lib/theme.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
$ApplySkinparams()

!include ../../models/legacy-erp.puml

title NovaPay — Payment Engine Components

Container_Boundary(pe, "Payment Engine") {
  Component(auth_handler, "Auth Handler", "Spring", "Processes authorization\nrequests from acquirers")
  Component(capture_handler, "Capture Handler", "Spring", "Captures authorized\ntransactions")
  Component(refund_handler, "Refund Handler", "Spring", "Processes full &\npartial refunds")
  Component(settle_handler, "Settlement Handler", "Spring", "Batches settled txns\nfor nightly clearing")
  Component(routing_engine, "Routing Engine", "Spring", "Selects optimal\nprocessor & route")
  Component(idempotency_store, "Idempotency Store", "Redis", "Prevents duplicate\ntransaction processing")
}

$CardNetwork()
$LegacyCore()

Component_Ext(fraud_api, "Fraud Detector", "gRPC", "Risk scoring")
Component_Ext(ledger_api, "Ledger Service", "gRPC", "Bookkeeping")

Rel(auth_handler, routing_engine, "~Selects route")
Rel(routing_engine, card_network, "~Sends auth", "ISO 8583")
Rel(auth_handler, fraud_api, "~Pre-auth check", "gRPC")
Rel(auth_handler, idempotency_store, "Checks/stores", "Redis")
Rel(capture_handler, ledger_api, "~Records capture", "gRPC")
Rel(refund_handler, ledger_api, "~Records refund", "gRPC")
Rel(settle_handler, legacy_core, "~Nightly batch", "SFTP")

LAYOUT_WITH_LEGEND()
@enduml
