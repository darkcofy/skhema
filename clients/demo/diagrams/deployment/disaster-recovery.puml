@startuml
!include ../../../../lib/theme.puml
$ApplySkinparams()

title NovaPay — Disaster Recovery Architecture

node "Route 53\n(Health-check failover)" as r53

node "eu-west-1 (Primary)" as primary {
  node "EKS Primary" as p_eks {
    component "Payment Engine" as p_pe
    component "Fraud Detector" as p_fd
    component "Ledger Service" as p_ls
  }
  database "Aurora Primary\n(Writer)" as p_db
  queue "MSK Kafka\nPrimary" as p_kafka
  storage "S3 Primary\n(Backups)" as p_s3
}

node "eu-central-1 (DR)" as dr {
  node "EKS Standby" as d_eks {
    component "Payment Engine\n(scaled to 0)" as d_pe
    component "Fraud Detector\n(scaled to 0)" as d_fd
    component "Ledger Service\n(scaled to 0)" as d_ls
  }
  database "Aurora Replica\n(Reader → promote)" as d_db
  queue "MSK Kafka\nMirrorMaker 2" as d_kafka
  storage "S3 Replica\n(CRR)" as d_s3
}

r53 --> p_eks : active
r53 ..> d_eks : standby\n(failover)

p_db -[#blue]-> d_db : async replication\nRPO < 1 min
p_kafka -[#blue]-> d_kafka : MirrorMaker 2\ntopic sync
p_s3 -[#blue]-> d_s3 : Cross-region\nreplication

note bottom of dr
  **RTO: 15 min** — Scale pods, promote Aurora, update Route 53
  **RPO: < 1 min** — Async replication lag
end note

@enduml
