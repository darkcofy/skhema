@startuml
!include ../../../../lib/theme.puml
$ApplySkinparams()

title NovaPay — Production Infrastructure

node "AWS eu-west-1 (Primary)" as primary {
  node "VPC — 10.0.0.0/16" as vpc {
    node "Public Subnet" as pub {
      component "ALB" as alb
      component "CloudFront" as cf
    }
    node "Private Subnet — App Tier" as app {
      node "EKS Cluster" as eks {
        component "Payment Engine\n(6 pods)" as pe
        component "Fraud Detector\n(4 pods)" as fd
        component "Ledger Service\n(3 pods)" as ls
        component "Notification Svc\n(2 pods)" as ns
        component "Webhook Engine\n(2 pods)" as wh
      }
    }
    node "Private Subnet — Data Tier" as data {
      database "Aurora PostgreSQL\n(Multi-AZ)" as aurora
      database "ElastiCache Redis\n(Cluster mode)" as redis
      queue "MSK Kafka\n(3 brokers)" as kafka
    }
  }
}

node "AWS eu-central-1 (DR)" as dr {
  database "Aurora Read Replica" as dr_db
  component "EKS Standby" as dr_eks
}

cloud "External" as ext {
  component "Visa / Mastercard" as cards
  component "Kroki API" as kroki
}

cf --> alb
alb --> pe
pe --> fd
pe --> ls
pe --> kafka
kafka --> ns
kafka --> wh
pe --> aurora
fd --> redis
ls --> aurora
aurora ..> dr_db : "async replication"
pe --> cards

@enduml
