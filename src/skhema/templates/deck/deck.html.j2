<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ client.name }} — Architecture Deck</title>

  <style>{{ reveal_css }}</style>
  <style>{{ theme_white_css }}</style>
  <style>{{ skhema_theme_css }}</style>
</head>
<body>

  <div class="reveal">
    <div class="slides">

      <section class="cover">
        <h1>{{ client.name }}</h1>
        {% if client.subtitle %}<p class="subtitle">{{ client.subtitle }}</p>{% endif %}
        <p class="meta">{{ generated_at.strftime('%B %Y') }}{% if total_diagrams %} · {{ total_diagrams }} diagram{{ 's' if total_diagrams != 1 else '' }}{% endif %}</p>
        <p class="presenter-hint">
          Navigate: <kbd>→</kbd> next · <kbd>↓</kbd> diagram notes ·
          <kbd>S</kbd> presenter view · <kbd>ESC</kbd> overview ·
          <kbd>F</kbd> fullscreen
        </p>
      </section>

      {% for section in sections %}
      <section>
        <section class="divider">
          <h2>{{ section.label }}</h2>
        </section>
        {% for diagram in section.diagrams %}

        <section class="diagram-slide">
          <h3>{{ diagram.title }}</h3>
          <div class="diagram">{{ diagram.svg_inline | safe }}</div>
          {% if diagram.prose_html %}
          <p class="sub-hint">↓ notes below · <kbd>S</kbd> for presenter view</p>
          {% endif %}
          {% if diagram.notes %}
          <aside class="notes">{{ diagram.notes | safe }}</aside>
          {% endif %}
        </section>

        {% if diagram.prose_html %}
        <section class="prose-slide">
          <h3>{{ diagram.title }} — notes</h3>
          <div class="diagram-prose">{{ diagram.prose_html | safe }}</div>
        </section>
        {% endif %}

        {% endfor %}
      </section>
      {% endfor %}

      {% if adrs %}
      <section>
        <section class="divider">
          <h2>Architecture Decisions</h2>
        </section>
        {% for adr in adrs %}
        <section class="adr-slide">
          <h3>ADR{{ "%02d"|format(adr.number) }}: {{ adr.title }}</h3>
          <p class="status status-{{ adr.status|lower }}">{{ adr.status }}</p>
          <div class="adr-body diagram-prose">{{ adr.body_html | safe }}</div>
        </section>
        {% endfor %}
      </section>
      {% endif %}

      <section class="cover">
        <h1>Thank you</h1>
        <p class="subtitle">Questions?</p>
        <p class="presenter-hint">
          For the speaker-view popup: serve the deck via
          <code>python -m http.server</code> and open over
          <code>http://</code> — then press <kbd>S</kbd>. File://
          URLs can't open popups in some browsers.
        </p>
      </section>

    </div>
  </div>

  <script>{{ reveal_js }}</script>
  <script>
    Reveal.initialize({
      hash: true,
      controls: true,
      progress: true,
      slideNumber: 'c/t',
      transition: 'slide',
      transitionSpeed: 'default',
      backgroundTransition: 'fade',
      pdfSeparateFragments: false,
      pdfMaxPagesPerSlide: 1,
      width: 1280,
      height: 720,
      margin: 0.04,
      minScale: 0.2,
      maxScale: 2.0,
      view: (location.search.match(/print-pdf/gi) ? 'print' : undefined),
    });
  </script>

</body>
</html>
