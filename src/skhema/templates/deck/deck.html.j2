<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ client.name }} — Architecture Deck</title>

  <style>{{ reveal_css }}</style>
  <style>{{ theme_white_css }}</style>
  <style>{{ skhema_theme_css }}</style>
</head>
<body>

  <div class="reveal">
    <div class="slides">

      <section class="cover">
        <h1>{{ client.name }}</h1>
        {% if client.subtitle %}<p class="subtitle">{{ client.subtitle }}</p>{% endif %}
        <p class="meta">{{ generated_at.strftime('%B %Y') }}{% if total_diagrams %} · {{ total_diagrams }} diagram{{ 's' if total_diagrams != 1 else '' }}{% endif %}</p>
        <p class="presenter-hint">
          <kbd>→</kbd> next · <kbd>↓</kbd> diagram notes ·
          <kbd>Click</kbd> a diagram to zoom · <kbd>ESC</kbd> overview · <kbd>F</kbd> fullscreen<br>
          <br>
          Presenter view with clock + next-slide + notes requires HTTP, not <code>file://</code>.<br>
          Run <code>skhema serve --client {{ client.slug | default(client.name|lower|replace(' ','-')) }}</code>, then press <kbd>S</kbd>.
        </p>
      </section>

      {% for section in sections %}
      <section>
        <section class="divider">
          <h2>{{ section.label }}</h2>
        </section>
        {% for diagram in section.diagrams %}

        <section class="diagram-slide">
          <h3>{{ diagram.title }}</h3>
          <div class="diagram" onclick="skhemaZoom(this)" title="Click to zoom">{{ diagram.svg_inline | safe }}</div>
          <p class="sub-hint">
            click diagram to zoom
            {% if diagram.prose_html %} · <kbd>↓</kbd> notes{% endif %}
            · <kbd>S</kbd> speaker view (HTTP only)
          </p>
          {% if diagram.notes %}
          <aside class="notes">{{ diagram.notes | safe }}</aside>
          {% endif %}
        </section>

        {% if diagram.prose_html %}
        <section class="prose-slide">
          <h3>{{ diagram.title }} — notes</h3>
          <div class="diagram-prose">{{ diagram.prose_html | safe }}</div>
        </section>
        {% endif %}

        {% endfor %}
      </section>
      {% endfor %}

      {% if adrs %}
      <section>
        <section class="divider">
          <h2>Architecture Decisions</h2>
        </section>
        {% for adr in adrs %}
        <section class="adr-slide">
          <h3>ADR{{ "%02d"|format(adr.number) }}: {{ adr.title }}</h3>
          <p class="status status-{{ adr.status|lower }}">{{ adr.status }}</p>
          <div class="adr-body diagram-prose">{{ adr.body_html | safe }}</div>
        </section>
        {% endfor %}
      </section>
      {% endif %}

      <section class="cover">
        <h1>Thank you</h1>
        <p class="subtitle">Questions?</p>
        <p class="presenter-hint">
          Gallery: <code>index.html</code> · Handbook: <code>{{ client.name|lower|replace(' ','-') }}-architecture.html</code><br>
          All outputs in this directory. Safe to email the whole folder.
        </p>
      </section>

    </div>
  </div>

  <!-- Zoom overlay: click any diagram to open it fullscreen; click to close. -->
  <div id="skhema-zoom" class="skhema-zoom" onclick="skhemaZoomClose()">
    <button class="skhema-zoom-close" aria-label="Close">&times;</button>
    <div class="skhema-zoom-inner"></div>
  </div>

  <script>{{ reveal_js }}</script>
  <script>
    Reveal.initialize({
      hash: true,
      controls: true,
      progress: true,
      slideNumber: 'c/t',
      transition: 'slide',
      transitionSpeed: 'default',
      backgroundTransition: 'fade',
      pdfSeparateFragments: false,
      pdfMaxPagesPerSlide: 1,
      // Bigger slide canvas so detailed C4 and deployment diagrams have room
      // before Reveal's viewport-fit scaling kicks in.
      width: 1600,
      height: 1000,
      margin: 0.03,
      minScale: 0.2,
      maxScale: 2.0,
      view: (location.search.match(/print-pdf/gi) ? 'print' : undefined),
    });

    // Click-to-zoom: open any diagram in a full-viewport overlay so the
    // user can read dense C4 / deployment diagrams without being stuck in
    // the slide's fixed aspect ratio.
    function skhemaZoom(el) {
      var overlay = document.getElementById('skhema-zoom');
      var inner = overlay.querySelector('.skhema-zoom-inner');
      inner.innerHTML = el.innerHTML;
      overlay.classList.add('active');
      document.body.classList.add('skhema-zoom-open');
    }
    function skhemaZoomClose(e) {
      if (e && e.target && e.target.closest('.skhema-zoom-inner svg')) return;
      document.getElementById('skhema-zoom').classList.remove('active');
      document.body.classList.remove('skhema-zoom-open');
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') skhemaZoomClose();
    });
  </script>

</body>
</html>
