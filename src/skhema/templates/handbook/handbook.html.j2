<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ client_name }} — Architecture Handbook</title>
  <style>{{ handbook_css | safe }}</style>
</head>
<body>

  <section class="cover">
    <h1>{{ client_name }}</h1>
    {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
    <p class="meta">Generated {{ generated_at }} — {{ total_diagrams }} diagram{{ 's' if total_diagrams != 1 else '' }}</p>
  </section>

  <nav class="toc" id="toc">
    <h2>Table of Contents</h2>
    <ul>
      {% for section in sections %}
      <li><a href="#section-{{ section.dtype }}">{{ section.label }}</a></li>
      {% endfor %}
    </ul>
  </nav>

  {% if overview_html %}
  <section class="overview">
    <div class="prose">{{ overview_html | safe }}</div>
  </section>
  {% endif %}

  {% for section in sections %}
  <section class="doc-section" id="section-{{ section.dtype }}">
    <h2>{{ section.label }}</h2>
    {% if section.overview_html %}
    <div class="section-overview prose">{{ section.overview_html | safe }}</div>
    {% endif %}
    {% for diagram in section.diagrams %}
    <div class="diagram-block">
      <h3>{{ diagram.name }}</h3>
      <div class="diagram-svg">{{ diagram.svg_inline | safe }}</div>
      {% if diagram.prose_html %}<div class="prose">{{ diagram.prose_html | safe }}</div>{% endif %}
      {% if diagram.adrs %}
      <div class="adr-section">
        <h4>Architecture Decisions</h4>
        {% for adr in diagram.adrs %}
        <div class="adr-entry">
          <h5>ADR{{ "%02d"|format(adr.number) }}: {{ adr.title }} ({{ adr.status }})</h5>
          {{ adr.body_html | safe }}
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endfor %}

  <footer class="footer">Generated by skhema on {{ generated_at }}</footer>

</body>
</html>
